# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Secrets / local config
.env
*.pem
*.key

# Runtime outputs
/data/raw/*
!/data/raw/.gitkeep
/data/cache/*
!/data/cache/.gitkeep
/reports/*
!/reports/.gitkeep

# OS / editors
.DS_Store
.vscode/
.idea/

# Private/manual team state
/data/manual/current_squad.csv
/data/manual/team_state.yaml
/data/manual/availability.csv
/data/manual/tactical_roles.csv

# Reproducibility snapshots stay in ArtifactStore / run artifacts, not source history.
data/snapshots/*
!data/snapshots/.gitkeep

# Runtime state is never source-authoritative.
data/generated/*
!data/generated/.gitkeep
!data/generated/README.md

# Local/reference V2 runtime backends.
.apex-runtime/
runtime/artifacts/
runtime/releases/
