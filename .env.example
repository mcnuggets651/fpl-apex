# Core
APEX_SEASON=2026-2027
APEX_HORIZON=6
APEX_BUDGET=100.0
APEX_CACHE_DIR=data/cache
APEX_REPORT_DIR=reports

# Optional exact current-squad transfer planning
APEX_CURRENT_SQUAD=data/manual/current_squad.csv
APEX_TEAM_STATE=data/manual/team_state.yaml

# Optional market projection endpoint
ODDS_API_KEY=
ODDS_API_URL=

# Optional AIrsenal projection export
AIRSENAL_HOME=
AIRSENAL_PROJECTIONS_CSV=

# Optional RSS/Atom feeds, comma-separated. Prefer official club feeds.
APEX_NEWS_FEEDS=

# Strict Apex safety gate
APEX_STRICT=true
APEX_REQUIRE_AIRSENAL=true
APEX_REQUIRE_CORE=true
APEX_PLAYER_CONTEXT=data/manual/player_context.csv
