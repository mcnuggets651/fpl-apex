# Apex FPL environment (never commit real credentials)
APEX_SEASON=2026-2027
APEX_HORIZON=8
APEX_BUDGET=100.0
APEX_CACHE_DIR=data/cache
APEX_SNAPSHOT_DIR=data/snapshots
APEX_REPORT_DIR=reports

# Personal FPL entry used for automatic post-deadline squad/transfer planning.
# Public mode reads only published deadline snapshots; it cannot see private
# transfers already made for the next deadline.
FPL_ENTRY_ID=63984

# Optional FPL Draft identity. This is read-only support for waiver/trade/ownership
# diagnostics and never changes the canonical Classic-FPL recommendation pipeline.
# The league ID is the numeric value used by /api/league/{id}/details.
FPL_DRAFT_LEAGUE_ID=
FPL_DRAFT_ENTRY_NAME=mcnuggets

# Genuine AIrsenal export created by scripts/export_airsenal.py
AIRSENAL_PROJECTIONS_CSV=data/generated/airsenal.csv

# Optional market model
ODDS_API_KEY=
ODDS_API_URL=

# Comma-separated RSS/Atom feeds. Prefer official clubs/league, then trusted media.
APEX_NEWS_FEEDS=

# Optional manual current-team override. Use this only when you have already made
# a transfer after the latest public deadline snapshot and want Apex to model it.
APEX_CURRENT_SQUAD=data/manual/current_squad.csv
APEX_TEAM_STATE=data/manual/team_state.yaml
APEX_TACTICAL_ROLES=data/manual/tactical_roles.csv
