{
  "name": "@fpl-apex/command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:web": "tsc -p tsconfig.web.json --noEmit",
    "check:worker": "tsc -p tsconfig.worker.json --noEmit",
    "check": "npm run check:web && npm run check:worker",
    "test": "vitest run",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "typescript": "5.7.3",
    "vitest": "3.0.7",
    "wrangler": "4.31.0"
  }
}
